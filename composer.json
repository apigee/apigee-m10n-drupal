{
    "name": "drupal/apigee_m10n",
    "license": "GPL-2.0",
    "type": "drupal-module",
    "description": "Apigee Edge Monetization for Drupal",
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-bcmath": "*",
        "cweagans/composer-patches": "~1.6",
        "commerceguys/intl": "^2.0",
        "drupal/apigee_edge": "dev-issue-1262 || dev-php-8.4-4.x",
        "drupal/core": "^10.5 || ^11.2",
        "drupal/requirement": "^1.3",
        "drupal/jquery_ui_dialog": "^2.1",
        "apigee/apigee-client-php": "dev-newer-php-version"
    },
    "require-dev": {
        "apigee/apigee-mock-client-php": "dev-issue-14",
        "drupal/drupal-extension": "~5",
        "drupal/core-dev": "^10.5 || ^11.2",
        "drush/drush": "^12.4.3 || ^13.3",
        "mglaman/drupal-check": "^1.5",
        "phpmd/phpmd": "^2.8.2",
        "phpmetrics/phpmetrics": "^2.5",
        "phpstan/phpstan": "^1.12"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "forked-apigee_edge": {
            "type": "vcs",
            "url": "https://github.com/shailesh-google/apigee-edge"
        },
        "forked-apigee_mock_client_php": {
            "type": "vcs",
            "url": "https://github.com/shailesh-google/apigee-mock-client-php"
        },
        "forked-apigee_client_php": {
            "type": "vcs",
            "url": "https://github.com/shailesh-google/apigee-client-php"
        }
    }
}
